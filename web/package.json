{
  "name": "events-manager-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "tokens": "node scripts/build-tokens.mjs",
    "start": "pnpm tokens && ng serve",
    "build": "pnpm tokens && ng build",
    "watch": "pnpm tokens && ng build --watch --configuration development",
    "test": "pnpm tokens && ng test"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "dependencies": {
    "@angular/cdk": "^22.0.5",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.5",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "style-dictionary": "^5.5.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
